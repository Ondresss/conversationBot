{
  "name": "C++ Server Container",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "workspaceFolder": "/app",
  
  "runArgs": [
    "-p", "9999:9999",
    "-p", "9998:9998",
    "-p", "11434:11434"
  ],

  "forwardPorts": [9999, 9998, 11434]
}