{
  "name": "C++ Server Container",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "workspaceFolder": "/app",
  
  "runArgs": [
    "-p", "0.0.0.0:9999:9999",
    "-p", "0.0.0.0:9998:9998",
    "-p", "0.0.0.0:11434:11434"
  ],
  "forwardPorts": [9999, 9998, 11434]
}